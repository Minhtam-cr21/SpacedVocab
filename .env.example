# Copy to .env and fill in values. .env is git-ignored — never commit real secrets.
DB_NAME=spacedvocab
DB_USERNAME=spacedvocab
DB_PASSWORD=change-me
DB_PORT=5432
APP_PORT=8090
ADMINER_PORT=8081

# JWT signing key (HS256), at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Browser origins allowed to call the API (comma-separated), e.g. the Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: first ADMIN account, created on startup if the email does not exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
